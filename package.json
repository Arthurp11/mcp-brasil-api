{
  "name": "mcp-brasil-api",
  "version": "0.1.0",
  "description": "Servidor MCP com dados públicos brasileiros (CNPJ, CEP, feriados, municípios) via BrasilAPI e IBGE.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "inspect": "mcp-inspector node dist/index.js"
  },
  "keywords": [],
  "author": "Arthur",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@modelcontextprotocol/inspector": "^2.13.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "@modelcontextprotocol/inspector": false
  }
}
